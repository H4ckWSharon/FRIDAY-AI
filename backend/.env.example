# ─────────────────────────────────────────────
# FRIDAY AI — Backend Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ─────────────────────────────────────────────

# Ollama server base URL
# Local development: http://localhost:11434
# Production VPS (after SSH tunnel / private VPC): http://<vps-private-ip>:11434
OLLAMA_BASE_URL=http://localhost:11434

# The exact model name as it appears in `ollama list`
# e.g. hf.co/RavichandranJ/Dolphin3-Cyber-8B-GGUF:Q8_0
OLLAMA_MODEL=hf.co/RavichandranJ/Dolphin3-Cyber-8B-GGUF:Q8_0

# How long (seconds) to wait for Ollama to respond
OLLAMA_TIMEOUT=120

# Backend server host & port
# In production containers / VPS: use 0.0.0.0
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ─── Inference Capacity & Concurrency Governor ────────
# Tuned for CPU inference on Intel i7-8700 (6 cores / 12 threads)
MAX_CONCURRENT_INFERENCES=2
MAX_INFERENCE_QUEUE=10
MAX_USER_CONCURRENT_INFERENCES=1

# Allowed browser origins for CORS (comma-separated)
# In production, set to your frontend domain(s), e.g. https://friday.yourdomain.com
CORS_ORIGINS=https://friday.yourdomain.com,http://localhost:5500,http://127.0.0.1:5500

# Set to "production" in production deployments to disable Swagger docs and suppress debug logs
APP_ENV=production

# ─── Database Connection ──────────────────────────────
# In production: provide PostgreSQL connection URL (e.g. Supabase, Neon, AWS RDS)
# If left empty, SQLite (friday.db) is used as a fallback.
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# ─── Firebase Authentication & Admin SDK ────────────────
FIREBASE_PROJECT_ID=friday-ai-27647
# Optional: path to backend service account json file (never commit to git)
# FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json
# Optional: raw service account JSON string for container/cloud deployment
# FIREBASE_SERVICE_ACCOUNT_JSON=

# ─── Razorpay Payment Gateway ──────────────────────────
# Dashboard: https://dashboard.razorpay.com/app/keys
# Use rzp_live_... for production, rzp_test_... for staging/testing
RAZORPAY_KEY_ID=rzp_live_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
# Webhook secret from Razorpay Dashboard > Webhooks
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here
